menu "ST SoC drivers"

config SOC_STM32MP2
	tristate "STM32MP2 SoC family support"
	depends on ARCH_STM32 || COMPILE_TEST
	default ARCH_STM32 && ARM64
	select SOC_BUS
	help
	  If you say yes here, you get support for the ST STM32MP2 family

config STI7105_SYSCONF
	bool "STi7105 system configuration registers"
	depends on CPU_SUBTYPE_ST40 || COMPILE_TEST
	default y if CPU_SUBTYPE_ST40
	help
	  SYS_CFG and SYS_STA of the STi7105. The PIO alternate-function
	  bits and the USB power requests live in this block.

endmenu
